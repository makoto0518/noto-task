// 【本番環境の接続設定】Workerの名前、D1、Workers AI、静的画面の場所をCloudflareへ伝える。
// worker/index.jsのenv.DBとenv.AIは、下のbinding名で接続できる。
// GOOGLE_CLIENT_SECRETやCF_ANALYTICS_TOKENは必ずCloudflareのSecretsへ保存する。
// GitHubに置くこのファイルへ秘密値を貼らない。Workers Freeのまま運用する。
// database_idは既に作成済みのD1を指すので、むやみに変更しない。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noto-task",
  "compatibility_date": "2026-10-16",
  "main": "./worker/index.js",
  "assets": { "directory": "./public", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "noto-db", "database_id": "29431c0d-8a42-4b9a-a98f-f3c15260052e" }],
  "ai": { "binding": "AI" }
}
